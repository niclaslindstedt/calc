# What `eas build` leaves out of the upload. EAS reads this file from the
# REPOSITORY ROOT only — a native/.easignore is never consulted — and when it
# exists it replaces every .gitignore in the tree. So the rules below are the
# root and native/ .gitignore files' own, with one deliberate difference:
#
#   native/assets/webroot.zip is NOT ignored. It is the packed web app — the
#   calculator itself — built by `npm run bundle` (in CI by native.yml, which
#   bakes the Dropbox key into it). It is gitignored as build output; left out
#   of the upload, the EAS worker fails at "Unable to resolve module
#   ../assets/webroot.zip".
#
# Keep this in step with the .gitignore files when they change. Check with
#   (cd native && npx eas-cli build:inspect -p ios -s archive -o <dir>)
# that the archive holds native/assets/webroot.zip.

# Common
.DS_Store
*.log
*.tmp
.env
.env.local
.env*.local

# Editors
.vscode/
.idea/
*.swp

# Coverage
.coverage/
coverage/

# Node
node_modules/
dist/
.expo/

# Store submission output and the listing's own words (see .gitignore).
native/store/copy.mts
native/store/store.config.json
native/store/screenshots/
native/fastlane/metadata/

# The desktop shell's build output.
tauri/target/
tauri/webroot/*
!tauri/webroot/.gitkeep
tauri/src-tauri/gen/

# Generated by `expo prebuild`, which runs on the EAS worker. LEADING
# SLASHES ARE LOAD-BEARING: anchored to native/, so modules/icloud-store/ios
# (hand-written Swift) still goes up.
/native/ios/
/native/android/

# Credentials — never uploaded.
*.p8
*.p12
*.jks
*.mobileprovision
play-service-account.json
